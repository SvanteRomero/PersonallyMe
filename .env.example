# ===========================================
# Personal Task Manager - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values
#
# Development: docker compose up -d
# Production:  docker compose -f docker-compose.prod.yml up --build -d

# -----------------------------
# Django Settings
# -----------------------------
DJANGO_SECRET_KEY=your-super-secret-key-change-in-production
DJANGO_DEBUG=True

# Environment: development or production
DJANGO_SETTINGS_MODULE=config.settings.development

# -----------------------------
# Domains (Production - set for your deployment)
# -----------------------------
FRONTEND_DOMAIN=your-frontend-domain.com
BACKEND_DOMAIN=your-backend-domain.com

# Full API URL the React app calls from the browser (baked in at build time)
VITE_API_URL=your-backend-domain.com/api

# -----------------------------
# Database (PostgreSQL)
# -----------------------------
POSTGRES_DB=taskmanager
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# For Docker Compose, use service name as host:
# POSTGRES_HOST=db

# -----------------------------
# JWT Settings
# -----------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# -----------------------------
# CORS Settings (auto-derived from FRONTEND_DOMAIN in docker-compose.prod.yml)
# Only set manually if you need custom values
# -----------------------------
CORS_ALLOWED_ORIGINS=fill-as-needed

# -----------------------------
# Email (Stubbed - for future use)
# -----------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# -----------------------------
# Production Only
# -----------------------------
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
